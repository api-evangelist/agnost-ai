      "items": [
        {
          "info": {
            "name": "Get dashboard metrics",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.agnost.ai/dashboard/api/dashboard",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get dashboard metrics"
        },
        {
          "info": {
            "name": "Generate login summary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.agnost.ai/dashboard/api/login-summary",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "query",
                "description": "Organization ID. Optional when org scope is supplied by JWT/API-key auth or `x-org-id`."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Generates a fresh 48-hour login summary for the selected organization.\nThe response is not persisted; dashboard clients request it after org\nselection settles, then keep it in memory for the current page session.\nIf no recent data exists, the endpoint returns a generic `summary_text`\nwith an empty `sections` array.\n"
        },
