            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the total event count matching the same filters as `/raw-logs`,\nserved from the `event_daily_stats` materialized view for sub-second\nlatency. The frontend issues this in parallel with `/raw-logs` so the\npage renders immediately and the total fills in when ready.\n\nReturns `{\"total_count\": null}` when the filter set cannot be answered\nby the materialized view (search query, client_config, connection_type,\nor arbitrary metadata keys other than event_type).\n"
        },
