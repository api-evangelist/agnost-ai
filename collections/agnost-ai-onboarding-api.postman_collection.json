        {
          "id": "949d10e2-4190-4942-8cc2-758de02edc6b",
          "name": "Suggest 6 intents to track for a given product",
          "request": {
            "name": "Suggest 6 intents to track for a given product",
            "description": {
              "content": "Given a product description, returns exactly 6 suggested intents\n(title + description pairs) that mix bug reports, frustration signals,\nfeature requests, churn signals, and positive signals. Always includes\ntwo general-purpose intents (\"Bug report\", \"Feature request\") plus\n4 product-specific suggestions. Used during organization setup to\nseed the intent list.\n\n`product_description` is capped at 5000 characters server-side.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "dashboard",
                "api",
                "onboarding",
                "suggest-intents"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_description\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "52ee563b-13f7-4318-9a11-73844ed450a2",
              "name": "Suggested intents",
