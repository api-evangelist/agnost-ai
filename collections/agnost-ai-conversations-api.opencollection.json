          },
          "http": {
            "method": "POST",
            "url": "https://api.agnost.ai/dashboard/api/conversation-detail",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get conversation detail (messages + spans combined)"
        },
        {
          "info": {
            "name": "Semantic search across conversations",
